# =============================================================================
# CI-Hermes environment variables — example / template
# =============================================================================
# CI-Hermes runs as a CI-Hub marketplace app; the wrapper (server.cjs) reads
# these from the container environment. Copy to `.env` for a local run and set
# only the values you need — everything has a sensible default. When deployed
# through CI-Hub, the CI_* / APP_* / HUB_* values are injected automatically and
# you do not set them by hand.
# =============================================================================

# ---------------------------------------------------------------------------
# Wrapper runtime
# ---------------------------------------------------------------------------

# Port the wrapper HTTP server binds to. Default: 18789
#PORT=18789

# One-time setup token that gates the first-run setup UI. Injected by CI-Hub;
# leave unset for a local run to allow open setup on loopback.
#APP_SEED=

# How long (ms) an idle PTY session is kept alive before it is reclaimed.
#PTY_IDLE_GRACE_MS=

# Allow the terminal WebSocket to fall back to a same-origin connection (bool,
# default off). Only enable for setups where the cross-origin WS is blocked.
#ALLOW_SAME_ORIGIN_WS_FALLBACK=false

# ---------------------------------------------------------------------------
# Public origin / routing — injected by CI-Hub (allowed origins + public URL)
# ---------------------------------------------------------------------------
# The wrapper allowlists these as valid Host/Origin values and uses APP_PUBLIC_URL
# as its externally-reachable address. Set for a standalone run behind a proxy.

#APP_HOST=
#APP_DOMAIN=
#APP_EXPOSED_DOMAIN=
#APP_URL=
#APP_PUBLIC_URL=

# ---------------------------------------------------------------------------
# CI-Hub linkage — injected by CI-Hub
# ---------------------------------------------------------------------------

# Base URL of the CI-Hub the app is installed under (HUB_URL is the legacy alias).
#CI_HUB_URL=
#HUB_URL=

# MCP API key the wrapper uses to call the Hub's MCP endpoint.
#HUB_MCP_API_KEY=

# ---------------------------------------------------------------------------
# Companion Memory (CI-Server) — injected by CI-Hub after the user connects
# ---------------------------------------------------------------------------
# You normally do NOT set these: the Hub's memory-connect flow injects the URL
# + minted key on every env regeneration. Set them manually only to point at an
# external CI-Server for a standalone run.

# Companion Memory (CI-Server) base URL the agent reads/writes long-term memory at.
#CI_SERVER_URL=http://localhost:3030

# Memory-scoped API key for CI_SERVER_URL (sent as x-api-key).
#CI_SERVER_TOKEN=

# Set to "false" to hard-disable the Companion Memory integration even when a
# URL + token are present. Default: enabled when both are set.
#CI_SERVER_ENABLED=

# The app's own URN — injected by CI-Hub so the wrapper can query its
# memory-connect state and decide whether to show the connect interstitial.
#CI_APP_URN=

# ---------------------------------------------------------------------------
# Error reporting (Sentry) — OPT-OUT: on wherever a DSN is set
# ---------------------------------------------------------------------------
# With no SENTRY_DSN the SDK is never loaded and the container makes no outbound
# connection — that is the absence of configuration, not a privacy setting.
# Only the wrapper (server.cjs) is instrumented — not the upstream Hermes
# dashboard or gateway. See docs/operations/error-reporting.md.

# DSN for the `ci-hermes` Sentry project. Set (as release images are) = reporting
# on unless a kill switch below says otherwise. Unset = nothing initialises.
#SENTRY_DSN=

# Environment tag on reported events. Falls back to CI_HERMES_ENVIRONMENT, then
# NODE_ENV, then "development".
#SENTRY_ENV=production

# Release tag. Defaults to ci-hermes-web@<CI_HERMES_VERSION> when that is set.
#SENTRY_RELEASE=

# App version: used for the release tag and the `deployment_version` event tag.
#CI_HERMES_VERSION=

# Kill switch: disables reporting even when a DSN is baked into the image, so it
# can be turned off without a rebuild. Values: off|false|0|no|disabled. This is
# what CI-Hub's "Share crash reports" toggle sets.
#CI_TELEMETRY=off

# Local-only mode: forbids ALL egress, telemetry included. Takes precedence over
# CI_TELEMETRY. Values: true|1|yes|on|enabled.
#CI_LOCAL_ONLY=true
